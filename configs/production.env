APP_NAME=myapp
APP_VERSION=1.0.0
APP_DEBUG=false
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=myapp_production
DATABASE_USERNAME=admin
DATABASE_PASSWORD=prod_secret_password_123
REDIS_HOST=redis.production.local
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pass
API_BASE_URL=https://api.example.com
API_TIMEOUT=30
API_RETRY_COUNT=3
LOGGING_LEVEL=INFO
LOGGING_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOGGING_FILE=/var/log/myapp/app.log
FEATURES_CACHE_ENABLED=true
FEATURES_RATE_LIMIT=1000
FEATURES_MAINTENANCE_MODE=false