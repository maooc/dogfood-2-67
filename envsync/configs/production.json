{
  "app": {
    "name": "myapp",
    "version": "2.0.0",
    "debug": false
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "myapp_production",
    "username": "admin",
    "password": "prod_secret_password_123"
  },
  "redis": {
    "host": "redis.production.local",
    "port": 6379,
    "password": "redis_secret_pass"
  },
  "api": {
    "base_url": "https://api.example.com",
    "timeout": 30,
    "retry_count": 3
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "/var/log/myapp/app.log"
  },
  "features": {
    "cache_enabled": true,
    "rate_limit": 1000,
    "maintenance_mode": false
  }
}